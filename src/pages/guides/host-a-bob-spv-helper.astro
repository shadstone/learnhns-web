h2 { font-size: 1.65rem; margin-bottom: 1rem; }
p, li { line-height: 1.8; color: var(--text-secondary); }
.lede { font-size: 1.2rem; }
a, .eyebrow { color: var(--hns-violet); }
section { padding: 1.5rem 0; border-bottom: 1px solid var(--glass-border); }
aside { padding: 1.3rem; border: 1px solid var(--hns-violet); border-radius: 12px; margin: 2rem 0; }
pre { overflow-x: auto; padding: 1.2rem; background: #090b10; color: #e8eaf0; border-radius: 10px; line-height: 1.6; }
code { overflow-wrap: anywhere; }
pre code { overflow-wrap: normal; }
footer { padding-top: 2rem; line-height: 1.8; }
</style>
