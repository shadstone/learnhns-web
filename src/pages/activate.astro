---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema, webPageSchema, abs } from '../lib/seo';

const description = 'Inspect a Handshake name, activate a hosted website or portable profile, and generate a safe DNS proposal without sharing wallet keys.';
---

<BaseLayout
  title="Activate My Name"
  description={description}
  keywords="Handshake domain activation, HNS website, hns.bio profile, Handshake DNS records"
  schema={[
    webPageSchema({ title: 'Activate My Name', description, url: abs('/activate/') }),
    breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Activate My Name', path: '/activate/' }]),
  ]}
>
  <div class="activate-shell">
    <section class="activate-hero">
      <div class="eyebrow"><span class="pulse"></span> Non-custodial activation studio</div>
      <h1>Give your Handshake name <em>a job.</em></h1>
      <p class="hero-copy">
        Inspect what your name does today. Then prepare a complete, reviewable
        DNS proposal for a hosted website or a portable hns.bio profile.
      </p>

      <form id="name-form" class="name-search" novalidate>
        <label for="name-input">Handshake name</label>
        <div class="search-row">
          <span class="root-mark" aria-hidden="true">/</span>
          <input id="name-input" name="name" autocomplete="off" spellcheck="false" placeholder="skyinclude or mike.agent" />
          <button class="primary-action" type="submit">Inspect name <span aria-hidden="true">→</span></button>
        </div>
        <div class="sample-row">
          <span>Try a live example:</span>
          <button type="button" class="sample-name" data-name="skyinclude">skyinclude/</button>
          <button type="button" class="sample-name" data-name="mike.agent">mike.agent</button>
        </div>
      </form>

      <div class="trust-strip" aria-label="Safety properties">
        <span><b>01</b> No seed phrases</span>
        <span><b>02</b> No silent updates</span>
        <span><b>03</b> Existing records preserved</span>
      </div>
    </section>

    <div id="notice" class="notice" role="status" aria-live="polite" hidden></div>

    <section id="workspace" class="workspace" hidden>
      <div class="inspection-head">
        <div>
          <span class="section-kicker">Live inspection</span>
          <h2 id="inspected-name">—</h2>
        </div>
        <div class="resolver-proof">
          <span class="proof-dot"></span>
          <div><strong id="resolver-label">Resolver</strong><small id="resolver-detail">Waiting</small></div>
        </div>
      </div>

      <div id="capabilities" class="capability-grid" aria-label="Detected capabilities"></div>

      <div class="workspace-grid">
        <aside class="record-panel">
          <div class="panel-head">
            <div><span class="section-kicker">Current state</span><h3>Resolved records</h3></div>
            <span id="record-count" class="count-pill">0</span>
          </div>
          <p class="panel-note">These are supported DNS observations, not automatically the raw payload a wallet signs. Changes are never published here.</p>
          <div id="record-list" class="record-list" tabindex="0"></div>
          <details class="resolver-notes">
            <summary>Resolver and privacy details</summary>
            <p id="resolver-notes-copy"></p>
          </details>
        </aside>

        <div class="builder-panel">
          <div class="mode-tabs" role="tablist" aria-label="Activation type">
            <button type="button" class="mode-tab is-active" role="tab" aria-selected="true" data-mode="website">
              <span class="mode-icon">↗</span><span><b>Website</b><small>Point to a web server</small></span>
            </button>
            <button type="button" class="mode-tab" role="tab" aria-selected="false" data-mode="profile">
              <span class="mode-icon">◎</span><span><b>Profile</b><small>Publish portable identity</small></span>
            </button>
          </div>

          <section id="website-mode" class="mode-content" aria-labelledby="website-title">
            <div class="mode-heading"><span class="step-number">1</span><div><h3 id="website-title">Connect an existing web server</h3><p>Use normal DNS address records. This is a hosted website—not a redirect or profile.</p></div></div>
            <form id="website-form" class="activation-form" novalidate>
              <div class="field-grid">
                <label>IPv4 address <span id="ipv4-record-label">A record</span><input id="ipv4" name="ipv4" inputmode="decimal" placeholder="203.0.113.10" /></label>
                <label>IPv6 address <span id="ipv6-record-label">AAAA record</span><input id="ipv6" name="ipv6" placeholder="2001:db8::10" /></label>
              </div>
              <div class="form-callout"><span>!</span><p id="publishing-guidance">The publishing layer will be identified after inspecting a name.</p></div>
              <button class="primary-action" type="submit">Build website proposal</button>
            </form>

            <div class="host-card">
              <div><span class="host-label">No server yet?</span><h4>Start with HostLimo</h4><p>Open the existing HostLimo control plane for a managed page or hosting path. No DNS changes happen automatically.</p></div>
              <a id="hostlimo-link" href="https://my.host.limo" target="_blank" rel="noopener">Open HostLimo ↗</a>
            </div>
          </section>

          <section id="profile-mode" class="mode-content" aria-labelledby="profile-title" hidden>
            <div class="mode-heading"><span class="step-number">1</span><div><h3 id="profile-title">Compose a portable profile</h3><p>Uses existing hns.bio TXT prefixes already understood by HeadlessProfile and SkyInclude.</p></div></div>
            <form id="profile-form" class="activation-form" novalidate>
              <div class="field-grid">
                <label>Display name <span>name:</span><input name="name" maxlength="120" placeholder="Your name or project" /></label>
                <label>Profile image <span>pfp:</span><input name="pfp" placeholder="https://example.com/avatar.png" /></label>
              </div>
              <label>Short bio <span>bio:</span><textarea name="bio" maxlength="500" rows="3" placeholder="What you build, offer, or believe in"></textarea></label>
              <div class="field-grid">
                <label>Primary link <span>link:</span><input name="link" placeholder="https://example.com" /></label>
                <label>Email <span>mail:</span><input name="mail" type="email" placeholder="hello@example.com" /></label>
                <label>X username <span>x:</span><input name="x" placeholder="yourhandle" /></label>
                <label>GitHub username <span>gh:</span><input name="gh" placeholder="yourname" /></label>
                <label>HNS address <span>hns:</span><input name="hns" placeholder="hs1…" /></label>
                <label>BTC address <span>btc:</span><input name="btc" placeholder="bc1…" /></label>
              </div>
              <div class="form-callout"><span>i</span><p>Only non-empty fields are updated. Existing unknown TXT records and all non-TXT records remain intact.</p></div>
              <button class="primary-action" type="submit">Build profile proposal</button>
            </form>
          </section>
        </div>
      </div>

      <section id="proposal-panel" class="proposal-panel" hidden>
        <div class="proposal-head">
          <div><span class="section-kicker">Review before publishing</span><h2>Your complete DNS change proposal</h2></div>
          <span id="proposal-mode" class="proposal-badge">Website</span>
        </div>
        <div id="proposal-errors" class="proposal-errors" role="alert" hidden></div>
        <div class="proposal-grid">
          <div>
            <h3>Before → after</h3>
            <div id="change-list" class="change-list"></div>
            <div class="proposal-actions">
              <button id="copy-proposal" type="button" class="primary-action">Copy JSON</button>
              <button id="download-proposal" type="button" class="secondary-action">Download proposal</button>
            </div>
            <p id="handoff-note" class="handoff-note">Review the publishing layer and patch before continuing in a trusted manager.</p>
          </div>
          <div id="preview-card" class="preview-card"></div>
        </div>
        <div class="verify-bar">
          <div><strong>Already published?</strong><span>Re-resolve the live name and test the result independently.</span></div>
          <button id="verify-live" type="button" class="secondary-action">Verify live name</button>
        </div>
        <div id="verification-result" class="verification-result" role="status" hidden></div>
      </section>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .activate-shell { max-width: 1220px; margin: 0 auto; padding: 0 1.5rem 5rem; }
  .activate-hero { padding: 6rem 0 3.5rem; max-width: 920px; }
  .eyebrow, .section-kicker { font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .12em; font-size: .68rem; font-weight: 700; color: var(--hns-violet-bright); }
  .eyebrow { display: flex; align-items: center; gap: .65rem; margin-bottom: 1.35rem; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--hns-mint); box-shadow: 0 0 0 5px rgba(0,240,192,.1); }
  .activate-hero h1 { font-family: var(--font-display); font-size: clamp(3rem, 7vw, 6rem); line-height: .95; letter-spacing: -.065em; max-width: 850px; }
  .activate-hero h1 em { color: var(--hns-violet-bright); font-style: normal; }
  .hero-copy { color: var(--text-secondary); font-size: 1.12rem; line-height: 1.65; max-width: 700px; margin: 1.5rem 0 2rem; }
  .name-search { max-width: 850px; }
  .name-search > label { display: block; font-weight: 700; font-size: .75rem; margin-bottom: .55rem; }
  .search-row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; background: var(--surface); border: 1px solid var(--glass-border-strong); border-radius: 16px; padding: .5rem; box-shadow: var(--shadow-card); }
  .search-row:focus-within { border-color: var(--hns-violet); box-shadow: 0 0 0 4px rgba(105,58,250,.12); }
  .root-mark { font-family: var(--font-mono); color: var(--hns-violet-bright); font-size: 1.5rem; padding: 0 .4rem 0 .8rem; }
  .search-row input { border: 0; background: transparent; color: var(--text-primary); padding: 1rem .5rem; font: 600 1.05rem var(--font-mono); min-width: 0; outline: none; }
  .primary-action, .secondary-action { border: 0; border-radius: 10px; padding: .9rem 1.2rem; font: 700 .82rem var(--font-sans); cursor: pointer; transition: transform .18s, background .18s, border-color .18s; }
  .primary-action { color: white; background: var(--hns-violet); }
  .primary-action:hover { background: var(--hns-violet-deep); transform: translateY(-1px); }
  .secondary-action { color: var(--text-primary); background: var(--surface); border: 1px solid var(--glass-border-strong); }
  .secondary-action:hover { border-color: var(--hns-violet); }
  .sample-row { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin-top: .85rem; color: var(--text-muted); font-size: .75rem; }
  .sample-name { border: 0; background: transparent; color: var(--hns-violet-bright); font: 600 .75rem var(--font-mono); cursor: pointer; }
  .trust-strip { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 2rem; color: var(--text-muted); font-size: .72rem; }
  .trust-strip b { font-family: var(--font-mono); color: var(--hns-mint); margin-right: .35rem; }
  .notice { margin: 1rem 0 2rem; padding: 1rem 1.2rem; border: 1px solid var(--glass-border); border-left: 3px solid var(--hns-violet); border-radius: 10px; background: var(--surface); color: var(--text-secondary); }
  .notice[data-kind="error"] { border-left-color: var(--down-color); color: var(--down-color); }
  .workspace { border-top: 1px solid var(--glass-border); padding-top: 2.5rem; }
  .inspection-head, .proposal-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; margin-bottom: 1.5rem; }
  .inspection-head h2 { font: 700 clamp(1.7rem,4vw,2.7rem) var(--font-mono); margin-top: .3rem; }
  .inspection-head h2::after { content: '/'; color: var(--hns-violet-bright); }
  .resolver-proof { display: flex; gap: .7rem; align-items: center; background: var(--surface); border: 1px solid var(--glass-border); border-radius: 12px; padding: .7rem .9rem; }
  .proof-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--up-color); }
  .resolver-proof strong, .resolver-proof small { display: block; }
  .resolver-proof strong { font-size: .76rem; }.resolver-proof small { color: var(--text-muted); font-size: .65rem; margin-top: .1rem; }
  .capability-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: .65rem; margin-bottom: 1.5rem; }
  .capability { padding: .85rem 1rem; background: var(--surface-soft); border: 1px solid var(--glass-border); border-radius: 10px; }
  .capability strong { display: block; font-size: .78rem; }.capability span { font-size: .67rem; color: var(--text-muted); }
  .capability.is-on { border-color: rgba(0,240,192,.35); background: rgba(0,240,192,.055); }.capability.is-on strong { color: var(--up-color); }
  .workspace-grid { display: grid; grid-template-columns: minmax(280px,.75fr) minmax(0,1.7fr); gap: 1rem; align-items: start; min-width: 0; }
  .record-panel, .builder-panel, .proposal-panel { background: var(--surface); border: 1px solid var(--glass-border); border-radius: 16px; box-shadow: var(--shadow-card); min-width: 0; }
  .record-panel { padding: 1.25rem; position: sticky; top: 80px; }
  .panel-head { display: flex; justify-content: space-between; align-items: center; }.panel-head h3 { font-size: 1rem; margin-top: .2rem; }
  .count-pill, .proposal-badge { font: 700 .68rem var(--font-mono); background: rgba(105,58,250,.12); color: var(--hns-violet-bright); border-radius: 999px; padding: .35rem .6rem; }
  .panel-note { font-size: .72rem; color: var(--text-muted); line-height: 1.55; margin: .8rem 0 1rem; }
  .record-list { max-height: 480px; overflow: auto; display: grid; gap: .45rem; }
  .record-row { display: grid; grid-template-columns: 54px minmax(0,1fr); gap: .55rem; padding: .62rem; background: var(--surface-soft); border-radius: 7px; font: .68rem/1.45 var(--font-mono); overflow-wrap: anywhere; }
  .record-row > span { min-width: 0; overflow-wrap: anywhere; word-break: break-word; }
  .record-type { color: var(--hns-violet-bright); font-weight: 700; }.empty-records { color: var(--text-muted); font-size: .78rem; padding: 1rem 0; }
  .resolver-notes { border-top: 1px solid var(--glass-border); margin-top: 1rem; padding-top: .8rem; font-size: .7rem; color: var(--text-muted); min-width: 0; overflow-wrap: anywhere; }.resolver-notes summary { cursor: pointer; color: var(--text-secondary); }.resolver-notes p { margin-top: .6rem; min-width: 0; overflow-wrap: anywhere; }
  .mode-tabs { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--glass-border); }
  .mode-tab { display: flex; gap: .8rem; text-align: left; align-items: center; border: 0; border-bottom: 2px solid transparent; padding: 1.15rem 1.3rem; background: transparent; color: var(--text-secondary); cursor: pointer; }
  .mode-tab.is-active { color: var(--text-primary); border-bottom-color: var(--hns-violet); background: rgba(105,58,250,.04); }
  .mode-icon { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 8px; background: var(--surface-soft); font-family: var(--font-mono); }.mode-tab b,.mode-tab small { display:block; }.mode-tab b { font-size: .82rem; }.mode-tab small { font-size: .66rem; color: var(--text-muted); margin-top: .1rem; }
  .mode-content { padding: 1.5rem; }.mode-heading { display: flex; gap: .9rem; margin-bottom: 1.3rem; }.step-number { flex: 0 0 auto; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; color: white; background: var(--hns-violet); font: 700 .7rem var(--font-mono); }.mode-heading h3 { font-size: 1rem; }.mode-heading p { color: var(--text-muted); font-size: .75rem; margin-top: .2rem; }
  .activation-form { display: grid; gap: 1rem; }.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }.activation-form label { color: var(--text-primary); font-size: .74rem; font-weight: 700; }.activation-form label span { float: right; color: var(--hns-violet-bright); font: .65rem var(--font-mono); }
  .activation-form input,.activation-form textarea { display: block; width: 100%; margin-top: .4rem; border: 1px solid var(--glass-border-strong); border-radius: 9px; background: var(--surface-soft); color: var(--text-primary); padding: .8rem .85rem; font: .8rem var(--font-mono); resize: vertical; }.activation-form input:focus,.activation-form textarea:focus { outline: 2px solid rgba(105,58,250,.3); border-color: var(--hns-violet); }
  .activation-form .primary-action { justify-self: start; }.form-callout { display: flex; gap: .7rem; padding: .85rem; border-radius: 9px; background: rgba(105,58,250,.07); color: var(--text-secondary); font-size: .7rem; line-height: 1.55; }.form-callout > span { color: var(--hns-violet-bright); font: 700 .8rem var(--font-mono); }
  .host-card { margin-top: 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem; border: 1px dashed var(--glass-border-bright); border-radius: 10px; }.host-label { color: var(--hns-mint); font: 700 .62rem var(--font-mono); text-transform: uppercase; }.host-card h4 { font-size: .88rem; margin: .15rem 0; }.host-card p { font-size: .68rem; color: var(--text-muted); max-width: 500px; }.host-card a { flex: 0 0 auto; color: var(--hns-violet-bright); font-size: .74rem; font-weight: 700; text-decoration: none; }
  .proposal-panel { margin-top: 1rem; padding: 1.5rem; border-color: rgba(105,58,250,.35); }.proposal-head h2 { font-size: 1.4rem; margin-top: .3rem; }.proposal-grid { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,.85fr); gap: 1rem; min-width: 0; }.proposal-grid > * { min-width: 0; }.proposal-grid h3 { font-size: .8rem; margin-bottom: .7rem; }.change-list { display: grid; gap: .65rem; min-width: 0; }.change-block { padding: .9rem; background: var(--surface-soft); border: 1px solid var(--glass-border); border-radius: 9px; min-width: 0; }.change-block h4 { font-size: .7rem; margin-bottom: .5rem; }.change-columns { display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); gap: .6rem; align-items: start; }.change-side { min-width: 0; }.change-side span { display: block; color: var(--text-muted); font-size: .6rem; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .3rem; }.change-side code { display: block; font: .64rem/1.5 var(--font-mono); color: var(--text-secondary); overflow-wrap: anywhere; word-break: break-word; }.change-arrow { color: var(--hns-violet-bright); padding-top: 1.3rem; }.proposal-actions { display: flex; gap: .6rem; margin-top: 1rem; flex-wrap: wrap; }.handoff-note { color: var(--text-muted); font-size: .68rem; line-height: 1.55; margin-top: .8rem; }.proposal-errors { color: var(--down-color); background: rgba(248,113,113,.08); border: 1px solid rgba(248,113,113,.25); padding: .8rem; border-radius: 9px; margin-bottom: 1rem; font-size: .75rem; }
  .preview-card { min-height: 260px; border-radius: 13px; padding: 1.4rem; background: linear-gradient(145deg,#161328,#0b0b14); color: white; border: 1px solid rgba(139,107,255,.35); overflow: hidden; position: relative; }.preview-card::before { content:''; position:absolute; width:180px;height:180px;border-radius:50%;background:rgba(105,58,250,.22);filter:blur(35px);right:-60px;top:-70px; }.preview-card > * { position: relative; }.preview-label { color:#a99aff;font:700 .6rem var(--font-mono);text-transform:uppercase;letter-spacing:.1em; }.preview-card h3 { font:700 1.45rem var(--font-display);margin:.7rem 0 .4rem; }.preview-card p { color:rgba(255,255,255,.65);font-size:.75rem; }.preview-records { margin-top:1.2rem;display:grid;gap:.45rem; }.preview-record { display:flex;justify-content:space-between;gap:.8rem;padding:.55rem .65rem;background:rgba(255,255,255,.055);border-radius:7px;font:.64rem var(--font-mono);overflow-wrap:anywhere; }.preview-record b { color:#a99aff; }.preview-avatar { width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#693afa,#00f0c0);display:grid;place-items:center;font:700 1rem var(--font-mono); }
  .verify-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--glass-border); }.verify-bar strong,.verify-bar span { display:block; }.verify-bar strong { font-size:.76rem; }.verify-bar span { color:var(--text-muted);font-size:.67rem;margin-top:.15rem; }.verification-result { margin-top:.8rem;padding:.85rem;border-radius:9px;background:var(--surface-soft);font-size:.72rem;color:var(--text-secondary); }.verification-result[data-kind="success"] { border-left:3px solid var(--up-color); }.verification-result[data-kind="partial"] { border-left:3px solid var(--warn-color); }.verification-result[data-kind="error"] { border-left:3px solid var(--down-color); }
  @media (max-width: 900px) { .capability-grid { grid-template-columns: repeat(2,1fr); }.workspace-grid,.proposal-grid { grid-template-columns:1fr; }.record-panel { position:static; }.record-list { max-height:280px; } }
  @media (max-width: 620px) { .activate-shell { padding:0 1rem 3rem; }.activate-hero { padding-top:3.5rem; }.activate-hero h1 { font-size:3.25rem; }.search-row { grid-template-columns:auto 1fr; }.search-row .primary-action { grid-column:1 / -1;width:100%; }.trust-strip { gap:.7rem;flex-direction:column; }.inspection-head,.proposal-head { align-items:flex-start;flex-direction:column; }.resolver-proof { width:100%; }.field-grid,.mode-tabs { grid-template-columns:1fr; }.mode-tab:first-child { border-bottom-width:1px; }.mode-tab.is-active { border-left:2px solid var(--hns-violet);border-bottom-color:var(--glass-border); }.mode-content,.proposal-panel { padding:1rem; }.host-card,.verify-bar { align-items:flex-start;flex-direction:column; }.change-columns { grid-template-columns:1fr; }.change-arrow { transform:rotate(90deg);padding:0;justify-self:center; }.capability-grid { grid-template-columns:1fr 1fr; }.proposal-actions > * { width:100%; } }
</style>

<script>
  import {
    RECORD_TYPES,
    PROFILE_FIELDS,
    analyzeRecords,
    buildDnsWireQuery,
    buildExport,
    createProfileProposal,
    createWebsiteProposal,
    flattenRecordSet,
    formatRecord,
    getPublishingContext,
    normalizeName,
    parseDnsJsonResponse,
    parseDnsWireResponse,
  } from '../lib/activate.mjs';

  const WIRE_RESOLVER = { id: 'hnsdoh', name: 'HNS DoH', transport: 'doh-wire', url: 'https://hnsdoh.com/dns-query' };
  const JSON_RESOLVER = { id: 'web3dns', name: 'Web3DNS', transport: 'dns-json', url: 'https://api.web3dns.net/' };
  const state = { name: '', displayName: '', records: [], resolver: null, warnings: [], mode: 'website', proposal: null, canonicalResourceHex: null };

  const byId = (id) => document.getElementById(id);
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;' }[char]));
  function showNotice(message, kind = 'info') {
    const notice = byId('notice');
    notice.textContent = message;
    notice.dataset.kind = kind;
    notice.hidden = false;
  }

  async function fetchWithTimeout(url, options = {}, timeout = 8000) {
    const controller = new AbortController();
    const timer = window.setTimeout(() => controller.abort(), timeout);
    try { return await fetch(url, { ...options, signal: controller.signal }); }
    finally { window.clearTimeout(timer); }
  }

  async function queryWire(name, type) {
    const queryName = type === 'TLSA' ? `_443._tcp.${name}` : name;
    const id = Math.floor(Math.random() * 65535);
    const query = buildDnsWireQuery(queryName, type, id);
    const response = await fetchWithTimeout(WIRE_RESOLVER.url, {
      method: 'POST',
      headers: { Accept: 'application/dns-message', 'Content-Type': 'application/dns-message' },
      body: query,
    });
    if (!response.ok) throw new Error(`${type}: HTTP ${response.status}`);
    return parseDnsWireResponse(await response.arrayBuffer(), queryName, type, id).records;
  }

  async function queryJson(name, type) {
    const queryName = type === 'TLSA' ? `_443._tcp.${name}` : name;
    const url = new URL(JSON_RESOLVER.url);
    url.searchParams.set('name', queryName);
    url.searchParams.set('type', type);
    const response = await fetchWithTimeout(url, { headers: { Accept: 'application/dns-json' } });
    if (!response.ok) throw new Error(`${type}: HTTP ${response.status}`);
    return parseDnsJsonResponse(await response.json(), name, type);
  }

  async function resolveName(name) {
    const wireResults = await Promise.allSettled(RECORD_TYPES.map((type) => queryWire(name, type)));
    const wireSuccesses = wireResults.filter((result) => result.status === 'fulfilled');
    if (wireSuccesses.length === RECORD_TYPES.length) {
      return { records: wireResults.flatMap((result) => result.value), resolver: WIRE_RESOLVER, warnings: [] };
    }
    if (wireSuccesses.length > 0) {
      return {
        records: wireResults.flatMap((result) => result.status === 'fulfilled' ? result.value : []),
        resolver: WIRE_RESOLVER,
        warnings: wireResults.map((result, index) => result.status === 'rejected' ? `${RECORD_TYPES[index]} unavailable` : '').filter(Boolean),
      };
    }

    const jsonResults = await Promise.allSettled(RECORD_TYPES.map((type) => queryJson(name, type)));
    const successes = jsonResults.filter((result) => result.status === 'fulfilled');
    if (!successes.length) throw new Error('No configured HNS resolver returned a usable response.');
    return {
      records: jsonResults.flatMap((result) => result.status === 'fulfilled' ? result.value : []),
      resolver: JSON_RESOLVER,
      warnings: jsonResults.map((result, index) => result.status === 'rejected' ? `${RECORD_TYPES[index]} unavailable` : '').filter(Boolean),
    };
  }

  async function fetchCanonicalResource(name) {
    if (name.includes('.')) return null;
    const response = await fetchWithTimeout('https://spv.learnhns.com/hsd', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ jsonrpc: '2.0', id: 'activate', method: 'getnameinfo', params: [name] }),
    });
    if (!response.ok) throw new Error(`canonical resource lookup returned HTTP ${response.status}`);
    const payload = await response.json();
    return payload?.result?.info?.data || null;
  }

  function renderCapabilities(records) {
    const { capabilities } = analyzeRecords(records);
    const labels = [
      ['website','Hosted website'],['delegatedDns','Delegated DNS'],['dnssec','DNSSEC'],['dane','DANE / TLSA'],
      ['profile','Portable profile'],['redirect','Redirect'],['payment','Payment'],['agent','Agent'],
    ];
    byId('capabilities').innerHTML = labels.map(([key,label]) => `
      <div class="capability ${capabilities[key] ? 'is-on' : ''}">
        <strong>${capabilities[key] ? '●' : '○'} ${label}</strong><span>${capabilities[key] ? 'Detected' : 'Not detected'}</span>
      </div>`).join('');
  }

  function renderRecords(records) {
    byId('record-count').textContent = String(records.length);
    byId('record-list').innerHTML = records.length ? records.map((record) => `
      <div class="record-row"><span class="record-type">${escapeHtml(record.type)}</span><span>${escapeHtml(record.name)} ${escapeHtml(record.value)}</span></div>
    `).join('') : '<p class="empty-records">No supported records were returned. You can still compose a new resource proposal.</p>';
  }

  function populateForms(records) {
    const analysis = analyzeRecords(records);
    byId('ipv4').value = analysis.set.A[0]?.value || '';
    byId('ipv6').value = analysis.set.AAAA[0]?.value || '';
    const profileForm = byId('profile-form');
    for (const { key } of PROFILE_FIELDS) {
      const input = profileForm.elements.namedItem(key);
      if (input) input.value = analysis.profile.fields[key] || '';
    }
    const context = getPublishingContext(state.name);
    byId('ipv4-record-label').textContent = `${context.addressTypes.ipv4} record`;
    byId('ipv6-record-label').textContent = `${context.addressTypes.ipv6} record`;
    byId('publishing-guidance').textContent = context.id === 'handshake-onchain'
      ? 'This one-label name is an on-chain Handshake TLD. Bob uses SYNTH4/SYNTH6 rather than ordinary A/AAAA in the signed resource. The canonical resource is captured separately so a wallet can merge the patch and show the full payload before signing.'
      : 'This dotted name is managed in an authoritative DNS or registry zone. Apply A/AAAA there; do not submit these as an on-chain Handshake TLD resource.';
  }

  async function inspect(rawName) {
    let normalized;
    try { normalized = normalizeName(rawName); }
    catch (error) { showNotice(error.message, 'error'); return; }
    showNotice(`Resolving ${normalized.displayName} across A, AAAA, CNAME, NS, DS, TXT and TLSA…`);
    byId('workspace').hidden = true;
    byId('proposal-panel').hidden = true;
    try {
      const result = await resolveName(normalized.asciiName);
      let canonicalResourceHex = null;
      if (!normalized.asciiName.includes('.')) {
        try { canonicalResourceHex = await fetchCanonicalResource(normalized.asciiName); }
        catch { result.warnings.push('canonical on-chain resource unavailable'); }
      }
      Object.assign(state, { name: normalized.asciiName, displayName: normalized.displayName, records: result.records, resolver: result.resolver, warnings: result.warnings, proposal: null, canonicalResourceHex });
      byId('inspected-name').textContent = normalized.displayName;
      byId('resolver-label').textContent = result.resolver.name;
      byId('resolver-detail').textContent = `${result.resolver.transport} · ${result.warnings.length ? 'partial response' : 'all supported types checked'}`;
      byId('resolver-notes-copy').textContent = `Queries were sent directly from this browser to ${result.resolver.url}. LearnHNS does not proxy or store them. ${result.warnings.length ? `Partial lookup: ${result.warnings.join(', ')}.` : 'The response question and transaction ID were validated before records were accepted.'}`;
      renderCapabilities(result.records);
      renderRecords(result.records);
      populateForms(result.records);
      byId('workspace').hidden = false;
      showNotice(`${normalized.displayName} resolved through ${result.resolver.name}. ${result.records.length} supported record${result.records.length === 1 ? '' : 's'} found${result.warnings.length ? `; ${result.warnings.join(', ')}.` : '.'}`);
      history.replaceState({}, '', `${location.pathname}?name=${encodeURIComponent(normalized.displayName)}`);
    } catch (error) {
      showNotice(`Could not inspect this name: ${error.message}`, 'error');
    }
  }

  function switchMode(mode) {
    state.mode = mode;
    document.querySelectorAll('.mode-tab').forEach((tab) => {
      const active = tab.dataset.mode === mode;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
    });
    byId('website-mode').hidden = mode !== 'website';
    byId('profile-mode').hidden = mode !== 'profile';
  }

  function renderProposal(proposal, mode) {
    state.proposal = proposal;
    const panel = byId('proposal-panel');
    panel.hidden = false;
    byId('proposal-mode').textContent = mode === 'website' ? 'Website' : 'Personal profile';
    if (proposal.publishingContext) {
      byId('handoff-note').textContent = proposal.publishingContext.id === 'handshake-onchain'
        ? `This is a ${proposal.publishingContext.addressTypes.ipv4 === 'SYNTH4' ? 'Handshake resource' : 'record'} patch, not a standalone UPDATE payload. Open it in ${proposal.publishingContext.manager}; the wallet must merge it with the canonical resource and show every resulting record before signing.`
        : `Apply this zone-record patch through ${proposal.publishingContext.manager}. Preserve unrelated records in that zone.`;
    }
    const errors = byId('proposal-errors');
    if (proposal.errors.length) {
      errors.hidden = false;
      errors.innerHTML = proposal.errors.map((error) => `<div>• ${escapeHtml(error)}</div>`).join('');
      byId('change-list').innerHTML = '';
      byId('preview-card').innerHTML = '<span class="preview-label">Proposal paused</span><h3>Fix the highlighted details</h3><p>Your current resource remains unchanged.</p>';
      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      return;
    }
    errors.hidden = true;
    byId('change-list').innerHTML = proposal.changes.map((change) => `
      <div class="change-block"><h4>${escapeHtml(change.section)}</h4><div class="change-columns">
        <div class="change-side"><span>Before</span>${change.before.length ? change.before.map((record) => `<code>${escapeHtml(formatRecord(record))}</code>`).join('') : '<code>None</code>'}</div>
        <div class="change-arrow">→</div>
        <div class="change-side"><span>After</span>${change.after.map((record) => `<code>${escapeHtml(formatRecord(record))}</code>`).join('')}</div>
      </div></div>`).join('');
    const analysis = analyzeRecords(proposal.records);
    if (mode === 'website') {
      const addresses = proposal.publicationPatch || [...analysis.set.A, ...analysis.set.AAAA];
      byId('preview-card').innerHTML = `<span class="preview-label">Hosted website configuration</span><h3>${escapeHtml(state.displayName)}/</h3><p>${escapeHtml(proposal.publishingContext.label)}. TXT profile records are optional and separate.</p><div class="preview-records">${addresses.map((record) => `<div class="preview-record"><b>${record.type}</b><span>${escapeHtml(record.value || record.address)}</span></div>`).join('')}</div>`;
    } else {
      const fields = analysis.profile.fields;
      const initials = (fields.name || state.displayName).slice(0,2).toUpperCase();
      byId('preview-card').innerHTML = `<span class="preview-label">hns.bio portable profile</span><div class="preview-avatar">${escapeHtml(initials)}</div><h3>${escapeHtml(fields.name || state.displayName)}</h3><p>${escapeHtml(fields.bio || 'Profile details are controlled by this name’s TXT records.')}</p><div class="preview-records">${['link','mail','x','gh','hns','btc'].filter((key) => fields[key]).map((key) => `<div class="preview-record"><b>${key}</b><span>${escapeHtml(fields[key])}</span></div>`).join('')}</div>`;
    }
    byId('verification-result').hidden = true;
    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function exportObject() {
    return buildExport({ name: state.name, resolver: state.resolver, currentRecords: state.records, proposal: state.proposal, mode: state.mode, canonicalResourceHex: state.canonicalResourceHex });
  }

  async function verifyLive() {
    if (!state.proposal || state.proposal.errors.length) return;
    const output = byId('verification-result');
    output.hidden = false; output.dataset.kind = 'partial'; output.textContent = 'Re-resolving the live name…';
    try {
      const live = await resolveName(state.name);
      if (state.mode === 'profile') {
        const expected = analyzeRecords(state.proposal.records).profile.fields;
        const actual = analyzeRecords(live.records).profile.fields;
        const changedKeys = Object.keys(expected).filter((key) => expected[key] !== analyzeRecords(state.records).profile.fields[key]);
        const matches = changedKeys.length > 0 && changedKeys.every((key) => actual[key] === expected[key]);
        output.dataset.kind = matches ? 'success' : 'partial';
        output.innerHTML = matches
          ? `Profile TXT records are live. <a href="https://headlessprofile.com/?domain=${encodeURIComponent(state.displayName)}" target="_blank" rel="noopener">Open in HeadlessProfile ↗</a>`
          : 'The proposed profile changes are not visible yet. Apply the patch in the identified manager, wait for confirmation, then recheck.';
      } else {
        const expected = analyzeRecords(state.proposal.records).set;
        const actual = analyzeRecords(live.records).set;
        const addressesMatch = ['A','AAAA'].every((type) => JSON.stringify(expected[type].map((r) => r.value).sort()) === JSON.stringify(actual[type].map((r) => r.value).sort()));
        if (!addressesMatch) {
          output.dataset.kind = 'partial';
          output.textContent = 'The proposed address records are not live yet. Apply the patch in the identified manager, wait for confirmation, then recheck.';
          return;
        }
        output.textContent = 'DNS matches. Asking HNS Best to retrieve the configured website…';
        await fetchWithTimeout(`https://hns.best/go/${encodeURIComponent(state.name)}`, { mode: 'no-cors', cache: 'no-store' }, 15000);
        output.dataset.kind = 'success';
        output.innerHTML = `Address records match and the HNS Best gateway retrieved the site. This proves gateway reachability, not native DANE trust. <a href="https://hns.best/go/${encodeURIComponent(state.name)}" target="_blank" rel="noopener">Open compatibility view ↗</a>`;
      }
    } catch (error) {
      output.dataset.kind = 'error';
      output.textContent = `Live verification failed: ${error.message}`;
    }
  }

  byId('name-form').addEventListener('submit', (event) => { event.preventDefault(); inspect(byId('name-input').value); });
  document.querySelectorAll('.sample-name').forEach((button) => button.addEventListener('click', () => { byId('name-input').value = button.dataset.name; inspect(button.dataset.name); }));
  document.querySelectorAll('.mode-tab').forEach((button) => button.addEventListener('click', () => switchMode(button.dataset.mode)));
  byId('website-form').addEventListener('submit', (event) => { event.preventDefault(); switchMode('website'); renderProposal(createWebsiteProposal(state.records, { ...Object.fromEntries(new FormData(event.currentTarget)), name: state.name }), 'website'); });
  byId('profile-form').addEventListener('submit', (event) => { event.preventDefault(); switchMode('profile'); renderProposal(createProfileProposal(state.records, { ...Object.fromEntries(new FormData(event.currentTarget)), __name: state.name }), 'profile'); });
  byId('copy-proposal').addEventListener('click', async () => { await navigator.clipboard.writeText(JSON.stringify(exportObject(), null, 2)); byId('copy-proposal').textContent = 'Copied'; window.setTimeout(() => { byId('copy-proposal').textContent = 'Copy JSON'; }, 1600); });
  byId('download-proposal').addEventListener('click', () => { const blob = new Blob([JSON.stringify(exportObject(), null, 2)], { type:'application/json' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `${state.name}-activate-proposal.json`; link.click(); URL.revokeObjectURL(link.href); });
  byId('verify-live').addEventListener('click', verifyLive);

  const initialName = new URLSearchParams(location.search).get('name');
  if (initialName) { byId('name-input').value = initialName; inspect(initialName); }
</script>
